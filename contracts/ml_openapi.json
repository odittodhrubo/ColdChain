{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthPoint": {
        "properties": {
          "score": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "ts": {
            "title": "Ts",
            "type": "integer"
          }
        },
        "required": [
          "ts",
          "score"
        ],
        "title": "HealthPoint",
        "type": "object"
      },
      "PredictIn": {
        "additionalProperties": false,
        "properties": {
          "fridge_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Fridge Id",
            "type": "string"
          },
          "health_history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/HealthPoint"
                },
                "maxItems": 500,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Health History"
          },
          "history_24h": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Reading"
                },
                "maxItems": 2000,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "History 24H"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "maxItems": 2000,
            "title": "Readings",
            "type": "array"
          }
        },
        "required": [
          "fridge_id",
          "readings"
        ],
        "title": "PredictIn",
        "type": "object"
      },
      "Reading": {
        "properties": {
          "batt": {
            "default": 100,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Batt",
            "type": "number"
          },
          "comp": {
            "default": 0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Comp",
            "type": "number"
          },
          "door": {
            "default": 0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Door",
            "type": "number"
          },
          "power": {
            "anyOf": [
              {
                "enum": [
                  "MAINS",
                  "BATTERY"
                ],
                "type": "string"
              },
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              }
            ],
            "default": "MAINS",
            "title": "Power"
          },
          "temp": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -60.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp"
          },
          "ts": {
            "exclusiveMaximum": 10000000000.0,
            "exclusiveMinimum": 1000000000.0,
            "title": "Ts",
            "type": "integer"
          }
        },
        "required": [
          "ts"
        ],
        "title": "Reading",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ColdChain ML service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/predict": {
      "post": {
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Predict Predict Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict"
      }
    },
    "/report": {
      "get": {
        "operationId": "report_report_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Report Report Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Report"
      }
    },
    "/report/figures/{name}": {
      "get": {
        "operationId": "figure_report_figures__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Figure"
      }
    }
  }
}
