# Copy to .env and fill in. `npm run env:init` does the copy and generates JWT_SECRET + APP_SECRET_KEY.
# Placeholders only. Never commit real credentials.

# backend
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=1h
BCRYPT_COST=12
DB_PATH=./data/coldchain.db
APP_SECRET_KEY=32-byte-hex-for-encrypting-device-secrets
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# mqtt. Default: the local dev broker, which `make demo` starts when nothing listens on it (virtual nodes).
# Wokwi nodes cannot reach localhost: for them use a cloud broker, e.g. HiveMQ Cloud on TLS
#   MQTT_URL=mqtts://<your-cluster>.s1.eu.hivemq.cloud:8883  plus MQTT_USERNAME / MQTT_PASSWORD
# Docker (`make up`): MQTT_URL=mqtt://mosquitto:1883
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# stable broker client id for the backend's persistent session (default coldchain-backend-<hostname>-<PORT>)
MQTT_CLIENT_ID=
MQTT_TOPIC_PREFIX=coldchain/v1
# device security
HMAC_WINDOW_S=30
NONCE_TTL_S=120
# per-device HMAC secrets, 64 hex each. Shared by the firmware config.h (node tools/init_firmware_config.js),
# the backend device registry and the virtual node. `npm run env:init` generates them.
DEVICE_SECRET_FRIDGE_01=
DEVICE_SECRET_FRIDGE_02=
# demo
DEMO_TIME_SCALE=1
# Demo simulation controls (open door, change temp, cut power/Wi-Fi from the web app). make demo turns this on.
SIM_CONTROLS=false
# alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
# P3: seconds before an unacknowledged WARNING/CRITICAL alert escalates once (0 = off)
ESCALATE_AFTER_S=600
# P2: local hours for the twice-daily temperature summary (comma-separated; empty = off)
DAILY_SUMMARY_HOURS=8,18
# ml
ML_URL=http://localhost:8000
ML_INTERVAL_MS=30000
# A1: offline forecast test MAE (°C) and the factor over it that flags live drift
FORECAST_TEST_MAE=0.66
FORECAST_DRIFT_FACTOR=2
# optional: an RFC 3161 Time-Stamp Authority that also signs each hourly audit anchor (only a hash is sent)
ANCHOR_TSA_URL=
# backups (online SQLite copies; keep the newest BACKUP_KEEP; copy them off-box yourself)
BACKUP_DIR=./data/backups
BACKUP_EVERY_MS=21600000
BACKUP_KEEP=28
# optional error tracking: a Sentry or GlitchTip DSN (events scrubbed of tokens, emails, secrets); off when empty.
# The web app takes its own at build time: VITE_ERROR_DSN
ERROR_DSN=
# Prometheus metrics on their own port, off when empty (e.g. 9464); bind stays on 127.0.0.1 unless METRICS_HOST
METRICS_PORT=
# P7: Web Push for BREACH/DOOR alerts (off when either key is empty). Generate a pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@coldchain.local
# raw readings older than this are deleted after hourly rollup (audited; Verify Integrity stays green); min 32
READINGS_RETENTION_DAYS=90
# production compose only (docs/backend.md, "Production with Docker"): the HTTPS site and the broker healthcheck account
SITE_ADDRESS=
HEALTHCHECK_PASSWORD=
