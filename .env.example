# Copy to .env and fill in. `npm run env:init` does the copy and generates JWT_SECRET + APP_SECRET_KEY.
# Placeholders only. Never commit real credentials.

# backend
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=1h
BCRYPT_COST=12
DB_PATH=./data/coldchain.db
APP_SECRET_KEY=32-byte-hex-for-encrypting-device-secrets
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# mqtt (default: HiveMQ Cloud, reachable from Wokwi; local dev broker: mqtt://localhost:1883)
MQTT_URL=mqtts://xxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=coldchain/v1
# device security
HMAC_WINDOW_S=30
NONCE_TTL_S=120
# demo
DEMO_TIME_SCALE=1
# alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
# ml
ML_URL=http://localhost:8000
