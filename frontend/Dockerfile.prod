# Production web image (infra/docker-compose.prod.yml): the built app served by Caddy, which also terminates HTTPS
# (automatic Let's Encrypt for a real domain) and proxies /api and /socket.io to the backend. One origin, no CORS.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# optional error tracking DSN (D4), baked into the bundle at build time; empty = off
ARG VITE_ERROR_DSN=
ENV VITE_ERROR_DSN=$VITE_ERROR_DSN
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
